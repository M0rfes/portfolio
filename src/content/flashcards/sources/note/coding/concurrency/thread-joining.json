    {
      "id": "note:coding/concurrency/thread-joining:0",
      "question": "How do you wait for spawned threads to finish before exiting main?",
      "answer": "Join the thread handle."
    },
    {
      "id": "note:coding/concurrency/thread-joining:1",
      "question": "What does joining wait for?",
      "answer": "The target thread to finish."
    },
    {
      "id": "note:coding/concurrency/thread-joining:2",
      "question": "What does joining return?",
      "answer": "The thread's result, or an indication that the thread panicked."
    }
  ]
